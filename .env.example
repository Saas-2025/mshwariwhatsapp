# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.

# MongoDB connection string (from MongoDB Atlas)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/whatsapp-gateway

# Secret used to sign JWT tokens — use a long, random string
JWT_SECRET=change-this-to-a-long-random-secret

# Backend port
PORT=3050

# URL the frontend uses to reach the backend
VITE_API_URL=http://localhost:3050

# Groq API key (AI Agent feature) — optional
GROQ_API_KEY=

# Gemini API key — optional
GEMINI_API_KEY=
